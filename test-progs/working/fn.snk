p = λx ⟨ print(x); ⟩;
p(1);

id = λx ⟨ x; ⟩;
print(id("Hello!"));

# Allow for a binding.
succ = λx ⟨ y = x + 1; y; ⟩;
print(succ(1));
print(succ(1));

sum = λx ⟨ λy ⟨ x + y; ⟩; ⟩;
print((sum(1))(2));
print((sum(1))(2));
print((sum(2))(2));

sum = λx ⟨ λy ⟨ z = x + y; z; ⟩; ⟩;
y = sum(3);
print(y(1));
print((sum(3))(2));
