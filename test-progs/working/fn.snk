p: int → int = λx ⟨ print(x); ⟩;
p(1);

id: str → str = λx ⟨ x; ⟩;
print(id("Hello!"));

# Allow for a binding.
succ: int → int = λx ⟨ y: int = x + 1; y; ⟩;
print(succ(1));
print(succ(1));

sum: int → int → int = λx ⟨ λy ⟨ x + y; ⟩; ⟩;
print((sum(1))(2));
print((sum(1))(2));
print((sum(2))(2));

sum: int → int → int = λx ⟨ λy ⟨ z: int = x + y; z; ⟩; ⟩;
y: int → int = sum(3);
print(y(1));
print((sum(3))(2));
