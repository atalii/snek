main: () → () = λx ⟨
  x: int = 0;

  x: int = 1;
  
  if x ≟ 1 ⟨
    ! print("x = 1");
  ⟩;
  
  if x < 2 ⟨
    ! print("x < 2");
  ⟩;
  
  ! print(x < 2, x ≟ 1);
  
  if (x < 2) ∧ (x ≟ 1) ⟨
    ! print("!");
  ⟩;
  
  if (x < 2) ∨ (x ≟ 0) ⟨
    ! print("!");
  ⟩;
  
  if (x ≟ 0) ∨ (x < 2) ∧ (x ≟ 1) ⟨
    ! print("!");
  ⟩;
  
  if ¬(x ≟ 0) ∧ (x < 2) ∧ (x ≟ 1) ∨ (1 ≟ 0) ⟨
    ! print("!");
  ⟩;
⟩;
