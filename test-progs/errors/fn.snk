p: int → () = λx ⟨ print(x); ⟩;

id: str → str = λx ⟨ x; ⟩;

succ: int → int = λx ⟨ y: int = x + 1; y; ⟩;

sum: int → int → int = λx ⟨ λy ⟨ x + y; ⟩; ⟩;

y: int → int = sum(3);

main: () → () = λx ⟨
  ! p(1);
  ! print(id("Hello!"));
  ! print(y(1));
  ! print((sum(3))(2));
  ! print(succ(1));
  ! print(succ(1));
  ! print((sum(1))(2));
  ! print((sum(1))(2));
  ! print((sum(2))(2));
⟩;
